<Window x:Class="WpfLab3.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfLab3.ViewModels"
        xmlns:models="clr-namespace:WpfLab3.Models"
        Style="{StaticResource AppWindowStyle}"
        Title="To-Do MVVM"
        Height="640" Width="900"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel Margin="24">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Список задач" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Паттерн MVVM · WPF · .NET 8"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Toolbar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource FilterPillStyle}"
                                 GroupName="Filter" Content="Все"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}"/>
                    <RadioButton Style="{StaticResource FilterPillStyle}"
                                 GroupName="Filter" Content="Активные"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Active}"/>
                    <RadioButton Style="{StaticResource FilterPillStyle}"
                                 GroupName="Filter" Content="Выполненные"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Completed}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Удалить выбранные"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteSelectedCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="+ Добавить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Padding="8,4" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"/>
            </Border>

            <!-- Tasks list -->
            <ListBox ItemsSource="{Binding FilteredTasks}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource TaskCardItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      ToolTip="Отметить для группового удаления"/>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsCompleted}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      ToolTip="Выполнена"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding Description, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="Изменить"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Удалить"
                                        Style="{StaticResource IconButtonStyle}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Busy overlay -->
        <Grid Background="#66FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="12" Padding="24,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="140" Height="6"
                                 Foreground="{StaticResource PrimaryBrush}" Background="#FFE9ECF3"/>
                    <TextBlock Text="Загрузка..." Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
